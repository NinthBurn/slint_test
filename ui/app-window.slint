import {
    VerticalBox,
    HorizontalBox,
    LineEdit,
    Button,
    Palette,
    ScrollView,
} from "std-widgets.slint";
import { DirectoryList, FileEntry } from "dir-list.slint";
import { Notification } from "notification.slint";
import { UBreadcrumb } from "@sleek-ui/widgets.slint";

export component AppWindow inherits Window {
    in property <[FileEntry]> files;
    in property <[string]> breadcrumb_steps;
    in property <string> search-path;
    in-out property <bool> editing-path: false;

    callback breadcrumb_step_clicked(int);
    callback directory_changed(string);
    callback show_notification(string);
    callback entry_clicked(int);
    callback request_search_path();
    callback go_back();
    callback go_forward();
    callback go_up();
    callback unfocus();

    unfocus => {
        pathEdit.clear-focus();
        editing-path = false;
    }
    show_notification(message) => notification.show(message);

    // Styling props  //
    min-width: 400px;
    min-height: 240px;
    preferred-width: 640px;
    preferred-height: 480px;
    // ============== //

    title: "File Manager";

    Rectangle {
        VerticalBox {
            padding: 8px;

            HorizontalLayout {
                spacing: 5px;

                Button {
                    icon: @image-url("../icons/caret-left-fill.svg");
                    colorize-icon: true;
                    clicked => go_back();
                }

                Button {
                    icon: @image-url("../icons/caret-right-fill.svg");
                    colorize-icon: true;
                    clicked => go_forward();
                }

                Button {
                    icon: @image-url("../icons/caret-up-fill.svg");
                    colorize-icon: true;
                    clicked => go_up();
                }

                Rectangle {
                    clip: true;
                    horizontal-stretch: 1;

                    pathEdit := LineEdit {
                        text: search-path;
                        enabled: editing-path;
                        visible: editing-path;
                        width: parent.width;
                        accepted(text) => {
                            editing-path = false;
                            directory_changed(text);
                        }

                        key-pressed(event) => {
                            if event.text == "\u{001b}" {
                                editing-path = false;
                                self.clear-focus();

                                request_search_path();
                                self.text = search-path;

                                EventResult.accept
                            }
                            EventResult.reject
                        }
                    }

                    if !editing-path: Rectangle {
                        background: Palette.alternate-background;
                        border-color: Palette.border;
                        border-width: 1px;
                        border-radius: 4px;
                        clip: true;

                        TouchArea {
                            clicked => {
                                editing-path = true;
                                request_search_path();
                                pathEdit.text = search-path;
                                pathEdit.focus();
                                pathEdit.select-all();
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;

                            ScrollView {
                                viewport-width: breadcrumb.content-width;
                                viewport-x: breadcrumb.content-width > self.width ? - (breadcrumb.content-width - self.width) : 0px;
                                breadcrumb := UBreadcrumb {
                                    steps: breadcrumb_steps;

                                    step-clicked(index, step) => {
                                        breadcrumb_step_clicked(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            DirectoryList {
                files: files;
                entry_clicked(entry) => root.entry_clicked(entry);
            }
        }

        notification := Notification {
            x: parent.width - self.width - 25px;
            y: parent.height - self.height - 25px;
        }
    }
}
