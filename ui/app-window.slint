import {
    VerticalBox,
    HorizontalBox,
    LineEdit,
    Button,
    Palette,
    ScrollView,
} from "std-widgets.slint";
import { DirectoryList, FileEntry } from "dir-list.slint";
import { NavigationBar } from "nav-bar.slint";
import { Notification } from "notification.slint";
import { UBreadcrumb } from "@sleek-ui/widgets.slint";

export component AppWindow inherits Window {
    in property <[FileEntry]> files;
    in property <[string]> breadcrumb_steps;
    in property <string> search-path;

    callback breadcrumb_step_clicked(int);
    callback directory_changed(string);
    callback show_notification(string);
    callback entry_clicked(int);
    callback request_search_path();
    callback go_back();
    callback go_forward();
    callback go_up();
    callback unfocus_path_edit();

    show_notification(message) => notification.show(message);

    // Styling props  //
    min-width: 400px;
    min-height: 240px;
    preferred-width: 640px;
    preferred-height: 480px;
    // ============== //

    title: "File Manager";

    Rectangle {
        VerticalBox {
            padding: 8px;

            // TODO: refactor this shitcu ce 
            NavigationBar {
                breadcrumb_steps: root.breadcrumb_steps;
                search-path: root.search-path;
                breadcrumb_step_clicked(index) => root.breadcrumb_step_clicked(index);
                go_back => root.go_back();
                go_forward => root.go_forward();
                go_up => root.go_up();
                unfocus_path_edit => root.unfocus_path_edit();
                request_search_path => root.request_search_path();
                directory_changed(path) => root.directory_changed(path);
             }

            DirectoryList {
                files: root.files;
                entry_clicked(entry) => root.entry_clicked(entry);
            }
        }

        notification := Notification {
            x: parent.width - self.width - 25px;
            y: parent.height - self.height - 25px;
        }
    }
}
